# --- Supabase (https://supabase.com -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (https://console.anthropic.com) --- server only
ANTHROPIC_API_KEY=
# Optional: override the model used by the tutor
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Moderation ---
# "on": newly published papers wait in an admin queue (status "pending") before going public.
# anything else: papers go public immediately (admins can still remove them, and users can report them).
PAPER_MODERATION=off

